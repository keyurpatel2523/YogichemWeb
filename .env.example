# Copy this file to .env locally. Never commit the real .env file.
# Placeholder values only.

# --- Database (PostgreSQL) ---
# Neon: use the pooled connection string (host contains "-pooler") and sslmode=require.
# Example: postgresql://user:password@ep-example-pooler.eu-west-2.aws.neon.tech/yogichem?sslmode=require
DATABASE_URL=postgresql://yogichem_app:CHANGE_ME@localhost:5432/yogichem

# --- Auth ---
# Signs customer and admin session cookies. At least 32 characters.
# Generate with: openssl rand -base64 48
SESSION_SECRET=CHANGE_ME_RANDOM_64_CHAR_SECRET

# --- First admin (used only by `npm run admin:create`, not by the running app) ---
# Refuses to run if any admin already exists. Password must be at least 12 characters
# and include a letter and a number. Do not commit real values.
ADMIN_INITIAL_EMAIL="admin@yogichemltd.com"
ADMIN_INITIAL_PASSWORD="Yogichem@12"
ADMIN_INITIAL_NAME="Brijesh Patel"

# --- Email (SendGrid). Orders still save if these are empty; confirmation mail is skipped. ---
SENDGRID_API_KEY=SG.CHANGE_ME
SENDGRID_FROM_EMAIL=orders@yourdomain.com
ADMIN_EMAIL=admin@yourdomain.com

# --- Product image uploads (Vercel Blob). Required in production. ---
# Local development can omit this and will write to public/uploads instead.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_CHANGE_ME

# --- Public site URL (exposed to the browser) ---
NEXT_PUBLIC_SITE_URL=https://yogichem.co.uk

# --- Runtime ---
# Vercel sets NODE_ENV and does not use PORT.
NODE_ENV=development
